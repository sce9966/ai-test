# 应用运行环境：development | production | test
NODE_ENV=development

# HTTP 监听端口
PORT=3100

# API / Swagger / 命名空间
APIPREFIX=/api
SWAGGERPREFIX=/docs
NAMESPACE=openkey

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_me
DB_DATABASE=openkey
# 开发环境可设为 true 自动建表；生产务必 false
DB_SYNCHRONIZE=true

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=
REDIS_DB=0

# --- JWT ---
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRESIN=7d

# --- 腾讯云 COS（上传）---
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_ACCELERATED_DOMAIN=

# --- 微信小程序 ---
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# --- 微信虚拟支付（道具直购）---
# true 时商品同步、下单签名、发货轮询、退款才会调用微信
WECHAT_XPAY_ENABLED=false
# MP：虚拟支付 → 基础配置 → OfferID
WECHAT_XPAY_OFFER_ID=
# 现网 AppKey（env=0）；沙箱 AppKey（env=1，仅 Android 等微信支付）
WECHAT_XPAY_APPKEY=
WECHAT_XPAY_SANDBOX_APPKEY=
# 0 现网 / 1 沙箱。iOS Apple 支付只能现网
WECHAT_XPAY_ENV=0
# 发货推送 Token / EncodingAESKey（消息加密选填）
WECHAT_XPAY_TOKEN=
WECHAT_XPAY_AES_KEY=
