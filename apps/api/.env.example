# 应用运行环境：development | production | test
NODE_ENV=development

# HTTP 监听端口
PORT=3000

# --- MySQL（指向已有实例；勿在本仓库用 docker-compose 拉起）---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_me
DB_DATABASE=admin_template

# TypeORM：仅 development 可用 true；生产必须 false，依赖 migration
DB_SYNCHRONIZE=false

# --- Redis（指向已有实例；勿在本仓库用 docker-compose 拉起）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
