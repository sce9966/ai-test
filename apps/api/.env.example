# 应用运行环境：development | production | test
NODE_ENV=development

# HTTP 监听端口
PORT=3100

# API / Swagger / 命名空间
APIPREFIX=/api
SWAGGERPREFIX=/docs
NAMESPACE=openkey

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=change_me
DB_DATABASE=openkey
# 开发环境可设为 true 自动建表；生产务必 false
DB_SYNCHRONIZE=true

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=
REDIS_DB=0

# --- JWT ---
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRESIN=7d

# --- 腾讯云 COS（上传）---
COS_BUCKET=
COS_REGION=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_ACCELERATED_DOMAIN=
